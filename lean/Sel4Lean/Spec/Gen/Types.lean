mutual
-- from SEL4/Object/Structures.lhs
/-- Haskell `data MDBNode = MDB { … }` -/
structure MDBNode where
  MDB ::
  mdbNext : PPtr CTE
  mdbPrev : PPtr CTE
  mdbRevocable : Bool
  mdbFirstBadged : Bool
-- from SEL4/Object/Structures.lhs
/-- Haskell `data CTE = CTE { … }` -/
structure CTE where
  CTE ::
  cteCap : Capability
  cteMDBNode : MDBNode
-- from SEL4/Object/Structures.lhs
/-- Haskell `data NTFN` -/
inductive NTFN where
  | IdleNtfn
  | ActiveNtfn (ntfnMsgIdentifier : Word)
  | WaitingNtfn (ntfnQueue : List (PPtr TCB))
-- from SEL4/Object/Structures.lhs
/-- Haskell `data Notification = NTFN { … }` -/
structure Notification where
  NTFN ::
  ntfnObj : Sel4Lean.Spec.NTFN
  ntfnBoundTCB : Option (PPtr TCB)
-- from SEL4/Object/Structures.lhs
/-- Haskell `data ThreadState` -/
inductive ThreadState where
  | BlockedOnReceive (blockingObject : PPtr Endpoint) (blockingIPCCanGrant : Bool)
  | BlockedOnReply
  | BlockedOnNotification (waitingOnNotification : PPtr Notification)
  | Running
  | Inactive
  | IdleThreadState
  | BlockedOnSend (blockingObject : PPtr Endpoint) (blockingIPCBadge : Word) (blockingIPCCanGrant : Bool) (blockingIPCCanGrantReply : Bool) (blockingIPCIsCall : Bool)
  | Restart
-- from SEL4/Object/Structures.lhs
/-- Haskell `data TCB = Thread { … }` -/
structure TCB where
  Thread ::
  tcbCTable : CTE
  tcbVTable : CTE
  tcbReply : CTE
  tcbCaller : CTE
  tcbIPCBufferFrame : CTE
  tcbDomain : Domain
  tcbState : ThreadState
  tcbMCP : Priority
  tcbPriority : Priority
  tcbQueued : Bool
  tcbFault : Option Fault
  tcbTimeSlice : Nat
  tcbFaultHandler : CPtr
  tcbIPCBuffer : VPtr
  tcbBoundNotification : Option (PPtr Notification)
  tcbSchedPrev : Option (PPtr TCB)
  tcbSchedNext : Option (PPtr TCB)
  tcbFlags : TcbFlags
  tcbArch : ArchTCB
-- from SEL4/Object/Structures.lhs
/-- Haskell `data Endpoint` -/
inductive Endpoint where
  | RecvEP (epQueue : List (PPtr TCB))
  | IdleEP
  | SendEP (epQueue : List (PPtr TCB))
-- from SEL4/Object/Structures.lhs
/-- Haskell `data Capability` -/
inductive Capability where
  | ThreadCap (capTCBPtr : PPtr TCB)
  | NullCap
  | NotificationCap (capNtfnPtr : PPtr Notification) (capNtfnBadge : Word) (capNtfnCanSend : Bool) (capNtfnCanReceive : Bool)
  | IRQHandlerCap (capIRQ : IRQ)
  | EndpointCap (capEPPtr : PPtr Endpoint) (capEPBadge : Word) (capEPCanSend : Bool) (capEPCanReceive : Bool) (capEPCanGrant : Bool) (capEPCanGrantReply : Bool)
  | DomainCap
  | Zombie (capZombiePtr : PPtr CTE) (capZombieType : ZombieType) (capZombieNumber : Nat)
  | ArchObjectCap (capCap : ArchCapability)
  | ReplyCap (capTCBPtr : PPtr TCB) (capReplyMaster : Bool) (capReplyCanGrant : Bool)
  | UntypedCap (capIsDevice : Bool) (capPtr : PPtr Unit) (capBlockSize : Nat) (capFreeIndex : Nat)
  | CNodeCap (capCNodePtr : PPtr CTE) (capCNodeBits : Nat) (capCNodeGuard : Word) (capCNodeGuardSize : Nat)
  | IRQControlCap
end

