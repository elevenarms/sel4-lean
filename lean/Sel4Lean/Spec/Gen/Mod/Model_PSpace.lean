/-- Haskell `deleteObjects` -/
def deleteObjects (ptr : PPtr Unit) (bits : Nat) : Kernel Unit :=
  do
    let _ ← unlessH (((PPtr.ptr ptr) &&& (mask bits)) == 0) (alignError bits)
