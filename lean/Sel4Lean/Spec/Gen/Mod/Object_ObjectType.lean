  | _, _, _, _, cap@(Capability.NotificationCap _ _ true _), _ => 
      do
        pure (Invocation.InvokeNotification (Capability.capNtfnPtr cap) (Capability.capNtfnBadge cap))
  | _, _, _, slot, cap@(Capability.ReplyCap _ false _), _ => 
      do
        pure (Invocation.InvokeReply (Capability.capTCBPtr cap) slot (Capability.capReplyCanGrant cap))
  | label, args, _, slot, cap@(Capability.ThreadCap ..), extraCaps => liftM Invocation.InvokeTCB (decodeTCBInvocation label args cap slot extraCaps)
  | label, args, _, _, Capability.DomainCap, extraCaps => liftM Invocation.InvokeDomain (decodeDomainInvocation label args extraCaps)
  | label, args, _, _, cap@(Capability.CNodeCap ..), extraCaps => liftM Invocation.InvokeCNode (decodeCNodeInvocation label args cap (map fst extraCaps))
  | label, args, _, slot, cap@(Capability.UntypedCap ..), extraCaps => liftM Invocation.InvokeUntyped (decodeUntypedInvocation label args slot cap (map fst extraCaps))
  | label, args, _, slot, Capability.IRQControlCap, extraCaps => liftM Invocation.InvokeIRQControl (decodeIRQControlInvocation label args slot (map fst extraCaps))
  | label, _, _, _, (Capability.IRQHandlerCap irq), extraCaps => liftM Invocation.InvokeIRQHandler (decodeIRQHandlerInvocation label irq extraCaps)
  | label, args, capIndex, slot, (Capability.ArchObjectCap cap), extraCaps => liftM Invocation.InvokeArchObject ((RISCV64.decodeInvocation) label args capIndex slot cap extraCaps)
  | _, _, _, _, _, _ => throw (SyscallError.InvalidCapability 0)

/-- Haskell `performInvocation` -/
def performInvocation (x0 : Bool) (x1 : Bool) (x2 : Invocation) : KernelP (List Word) :=
  match x0, x1, x2 with
  | _, _, (Invocation.InvokeUntyped invok) => 
      do
        let _ ← invokeUntyped invok
        pure []
  | block, call, (Invocation.InvokeEndpoint ep badge canGrant canGrantReply) => 
      withoutPreemption (do
        let thread ← getCurThread
        let _ ← sendIPC block call badge canGrant canGrantReply thread ep
        pure [])
  | _, _, (Invocation.InvokeNotification ep badge) => 
      do
        let _ ← withoutPreemption (sendSignal ep badge)
        pure []
  | _, _, (Invocation.InvokeReply thread slot canGrant) => 
      withoutPreemption (do
        let sender ← getCurThread
        let _ ← doReplyTransfer sender thread slot canGrant
        pure [])
  | _, _, (Invocation.InvokeTCB invok) => invokeTCB invok
  | _, _, (Invocation.InvokeDomain invok) => 
      do
        let _ ← withoutPreemption (invokeDomain invok)
        pure []
  | _, _, (Invocation.InvokeCNode invok) => 
      do
        let _ ← invokeCNode invok
        pure []
  | _, _, (Invocation.InvokeIRQControl invok) => 
      do
        let _ ← performIRQControl invok
        pure []
  | _, _, (Invocation.InvokeIRQHandler invok) => 
      do
        let _ ← withoutPreemption (invokeIRQHandler invok)
        pure []
  | _, _, (Invocation.InvokeArchObject invok) => (RISCV64.performInvocation) invok

end
