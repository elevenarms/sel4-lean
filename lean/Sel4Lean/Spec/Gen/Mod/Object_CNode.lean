      pure ((true, Capability.NullCap))
    else
      do
        let final ← withoutPreemption (isFinalCapability cte)
        let (remainder, info) ← withoutPreemption (finaliseCap (CTE.cteCap cte) final false)
        if capRemovable remainder slot then
          pure ((true, info))
        else
          if (not exposed) && (capCyclicZombie remainder slot) then
            do
              withoutPreemption (updateCap slot remainder)
              pure ((false, Capability.NullCap))
          else
            do
              withoutPreemption (updateCap slot remainder)
              reduceZombie remainder slot exposed
              preemptionPoint
              finaliseSlot slot exposed

